{
    "name": "delivery-system/php",
    "description": "Sistema de Delivery com PDO",
    "type": "project",
    "require": {
        "php": ">=7.4.0",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-curl": "*"
    },
    "autoload": {
        "files": [
            "config.php",
            "conexao.php"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "echo 'Instalação concluída!'",
            "php -m | grep pdo"
        ]
    }
}