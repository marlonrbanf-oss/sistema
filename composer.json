{
    "name": "academia-nova-arte/sistema",
    "description": "Sistema Academia Nova Arte",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "php": "^8.2"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "platform-check": true,
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -v",
            "@php -m"
        ]
    }
}